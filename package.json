{
  "name": "prc-hardware-api",
  "version": "1.0.0",
  "description": "Pacific Hardware Enterprise REST API",
  "main": "dist/server.js",
  "overrides": {
    "fast-csv": "^4.3.6",
    "tmp": "^0.2.5",
    "uuid": "^14.0.1"
  },
  "scripts": {
    "dev": "ts-node src/server.ts",
    "dev:worker": "ts-node src/jobs/worker.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').mkdirSync('dist/public',{recursive:true});require('fs').copyFileSync('src/public/docs.html','dist/public/docs.html')\"",
    "start": "node dist/server.js",
    "start:cluster": "node dist/server.js",
    "start:worker": "node dist/jobs/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "ts-node src/scripts/run-tests.ts",
    "test:live": "ts-node src/scripts/test-live-allocation-db.ts",
    "test:integration": "ts-node src/scripts/run-integration-tests.ts",
    "typecheck": "tsc --noEmit",
    "audit": "node src/scripts/audit/run.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@imagekit/nodejs": "^7.10.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/compression": "^1.8.1",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.9",
    "bwip-js": "^4.11.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "imagekit": "^6.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.4",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.4",
    "resend": "^6.18.1",
    "slugify": "^1.6.6",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bwip-js": "^3.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.0",
    "eslint-plugin-security": "^1.5.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
