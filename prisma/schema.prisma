  allocatedOrders Order[]        @relation("OrderAllocatedCourier")

  @@index([code])
  @@index([isActive])
  @@map("couriers")
}

model ShippingZone {
  id          String   @id @default(uuid())
  courierId   String?
  zoneCode    String?
  zoneName    String?
  name        String
  description String?
  countries   String[] @default(["India"])
  states      String[] @default([])
  postalCodes String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  courier           Courier?               @relation(fields: [courierId], references: [id], onDelete: SetNull)
  rates             ShippingRate[]
  courierRates      CourierRate[]
  warehouseMappings WarehouseZoneMapping[]
  shipments         Shipment[]
  allocatedOrders   Order[]                @relation("OrderAllocatedZone")

  @@index([courierId])
  @@index([zoneCode])
  @@index([isActive])
  @@map("shipping_zones")
}

model WarehouseZoneMapping {
  id          String   @id @default(uuid())
  warehouseId String
  zoneId      String
  pinStart    String
  pinEnd      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([zoneId])
  @@index([pinStart, pinEnd])
  @@map("warehouse_zone_mappings")
}

model CourierRate {
  id                    String   @id @default(uuid())
  courierId             String
  zoneId                String
  weightFrom            Decimal  @db.Decimal(8, 3)
  weightTo              Decimal  @db.Decimal(8, 3)
  baseRate              Decimal  @db.Decimal(10, 2)
  additionalRate        Decimal  @default(0) @db.Decimal(10, 2)
  fuelSurcharge         Decimal  @default(0) @db.Decimal(5, 2)
  handlingCharge        Decimal  @default(0) @db.Decimal(10, 2)
  codCharge             Decimal  @default(0) @db.Decimal(10, 2)
  estimatedDeliveryDays Int      @default(3)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  courier Courier      @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([courierId])
  @@index([zoneId])
  @@index([weightFrom, weightTo])
  @@index([isActive])
  @@map("courier_rates")
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  warehouseId    String
  courierId      String?
  zoneId         String?
  shippingCost   Decimal  @db.Decimal(10, 2)
  deliveryDays   Int?
  trackingNumber String?
  shipmentStatus String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  courier   Courier?      @relation(fields: [courierId], references: [id], onDelete: SetNull)
  zone      ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([orderId])
  @@index([warehouseId])
  @@index([courierId])
  @@index([shipmentStatus])
  @@map("shipments")
}

// ─── Enterprise Invoice Management System Models ──────────────────────────────

enum InvoiceType {
  TAX_INVOICE
  PROFORMA_INVOICE
  QUOTATION
  DELIVERY_CHALLAN
  PACKING_SLIP
  PURCHASE_ORDER
  CREDIT_NOTE
  DEBIT_NOTE
  COMMERCIAL_INVOICE
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
  ARCHIVED
}

model Invoice {
  id                     String        @id @default(uuid())
  invoiceNumber          String        @unique
  financialYear          String
  invoiceType            InvoiceType   @default(TAX_INVOICE)
  status                 InvoiceStatus @default(DRAFT)
  customerId             String?
  warehouseId            String?
  orderId                String?
  shipmentId             String?
  paymentId              String?
  subtotal               Decimal       @db.Decimal(12, 2)
  discount               Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount          Decimal       @db.Decimal(12, 2)
  cgst                   Decimal       @default(0) @db.Decimal(12, 2)
  sgst                   Decimal       @default(0) @db.Decimal(12, 2)
  igst                   Decimal       @default(0) @db.Decimal(12, 2)
  cess                   Decimal       @default(0) @db.Decimal(12, 2)
  roundOff               Decimal       @default(0) @db.Decimal(6, 2)
  grandTotal             Decimal       @db.Decimal(12, 2)
  amountInWords          String?
  currency               String        @default("INR")
  exchangeRate           Decimal       @default(1.0) @db.Decimal(8, 4)
  placeOfSupply          String?
  isReverseCharge        Boolean       @default(false)
  dueDate                DateTime?
  paymentTerms           String?       @default("DUE_ON_RECEIPT")
  verificationToken      String        @unique @default(uuid())
  verificationId         String        @unique
  documentHash           String
  digitalSignatureStatus String        @default("UNSIGNED")
  signedAt               DateTime?
  pdfPath                String?
  createdBy              String?
  approvedBy             String?
  approvedAt             DateTime?
  emailedAt              DateTime?
  printedAt              DateTime?
  cancelledAt            DateTime?
  notes                  String?
  internalRemarks        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // Relations
  customer  User?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment  Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  history   InvoiceHistory[]

  @@index([invoiceNumber])
  @@index([financialYear])
  @@index([invoiceType])
  @@index([status])
  @@index([customerId])
  @@index([orderId])
  @@index([verificationToken])
  @@map("invoices")
}

model InvoiceItem {
  id           String   @id @default(uuid())
  invoiceId    String
  productId    String?
  sku          String
  productName  String
  description  String?
  hsnCode      String?
  unit         String   @default("PCS")
  quantity     Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  taxableValue Decimal  @db.Decimal(12, 2)
  cgstRate     Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  sgstRate     Decimal  @default(0) @db.Decimal(5, 2)
  sgstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  igstRate     Decimal  @default(0) @db.Decimal(5, 2)
  igstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  cessRate     Decimal  @default(0) @db.Decimal(5, 2)
  cessAmount   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([sku])
  @@index([hsnCode])
  @@map("invoice_items")
}

model InvoiceHistory {
  id          String   @id @default(uuid())
  invoiceId   String
  action      String
  performedBy String?
  comment     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([action])
  @@map("invoice_history")
}

model InvoiceSequence {
  id            String      @id @default(uuid())
  invoiceType   InvoiceType
  financialYear String
  branchCode    String      @default("MAIN")
  nextNumber    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([invoiceType, financialYear, branchCode])
  @@map("invoice_sequences")
}

model ShippingRate {
  id             String   @id @default(uuid())
  zoneId         String
  name           String
  minWeight      Decimal  @default(0) @db.Decimal(8, 3)
  maxWeight      Decimal? @db.Decimal(8, 3)
  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxOrderAmount Decimal? @db.Decimal(12, 2)
  rate           Decimal  @db.Decimal(10, 2)
  estimatedDays  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_rates")
}

