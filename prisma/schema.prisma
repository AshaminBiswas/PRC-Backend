// ─── Courier & Logistics Models ────────────────────────────────────────────────

model Courier {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  isActive    Boolean  @default(true)
  trackingUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

