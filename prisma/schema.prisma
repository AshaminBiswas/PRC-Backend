}

model Enquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    EnquiryStatus @default(OPEN)
  userId    String?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([userId])
  @@map("enquiries")
}

model CmsPage {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  content         String        @db.Text
  status          ContentStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@map("cms_pages")
}

model BlogPost {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  content         String        @db.Text
  excerpt         String?       @db.Text
  thumbnail       String?
  category        String?
  tags            String[]      @default([])
  authorId        String?
  authorName      String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([authorId])
  @@map("blog_posts")
}

model FaqCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  faqs Faq[]

  @@index([slug])
  @@map("faq_categories")
}

model Faq {
  id         String      @id @default(uuid())
  categoryId String
  question   String
  answer     String      @db.Text
  position   Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isActive])
  @@map("faqs")
}

model Banner {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  badgeText    String?
  desktopImage String    @default("")
  tabletImage  String?
  mobileImage  String?
  image        String?
  linkUrl      String?
  link         String?
  ctaText      String?   @default("Explore Now")
  position     String    @default("HERO_SLIDER")
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([position, isActive, order])
  @@index([position])
  @@index([isActive])
  @@map("banners")
}

model HomepageSection {
  id            String   @id @default(uuid())
  title         String
  subtitle      String?
  type          String
  configuration Json?
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([position])
  @@index([isActive])
  @@map("homepage_sections")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  group       String   @default("GENERAL")
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@index([isPublic])
  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Inventory, Multi-Venture & POS Enums ─────────────────────────────────────

enum VentureStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DISCONTINUED
}

enum StockMovementType {
  PURCHASE
  SALE
  POS_SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING
  CLOSING
  DAMAGE
  LOST
  RESERVED
  RELEASED
}

enum TransferType {
  WAREHOUSE_TO_WAREHOUSE
  STORE_TO_STORE
  BRANCH_TO_BRANCH
  INTER_VENTURE
}

enum TransferStatus {
  DRAFT
  REQUESTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum DispatchStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PosSessionStatus {
  OPEN
  CLOSED
  SUSPENDED
}

enum PosSaleStatus {
  COMPLETED
  RETURNED
  VOIDED
}

enum PosPaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  CHEQUE
  MIXED
}

// ─── Venture ──────────────────────────────────────────────────────────────────

model Venture {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  code               String        @unique
  type               String        @default("RETAIL")
  address            String?
  gstin              String?       @db.VarChar(15)
  pan                String?
  logo               String?
  contactEmail       String?
  contactPhone       String?
  currency           String        @default("INR")
  timezone           String        @default("Asia/Kolkata")
  financialYearStart String        @default("04-01")
  status             VentureStatus @default(ACTIVE)
  settings           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  // Relations
  ventureUsers      VentureUser[]
  warehouses        Warehouse[]
  inventoryProducts InventoryProduct[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  stockTransfers    StockTransfer[]   @relation("VentureTransfers")
  stockTransfersFrom StockTransfer[]   @relation("TransferFromVenture")
  stockTransfersTo   StockTransfer[]   @relation("TransferToVenture")
  dispatches        Dispatch[]
  posStores         PosStore[]
  stockMovements    StockMovement[]
  activityLogs      InventoryActivityLog[]

  @@index([slug])
  @@index([code])
  @@index([status])
  @@map("ventures")
}

model VentureUser {
  id        String   @id @default(uuid())
  ventureId String
  userId    String
  roleId    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([ventureId, userId])
  @@index([ventureId])
  @@index([userId])
  @@map("venture_users")
}

// ─── Indian PIN Code Database ─────────────────────────────────────────────────

model PinCode {
  id            String   @id @default(uuid())
  pincode       String   @unique
  postOffice    String?
  city          String
  district      String
  state         String
  latitude      Float
  longitude     Float
  country       String   @default("India")
  isServiceable Boolean  @default(true)
  geohash       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pincode])
  @@index([state])
  @@index([district])
  @@index([city])
  @@index([geohash])
  @@map("pincodes")
}

// ─── Warehouse ────────────────────────────────────────────────────────────────

model Warehouse {
  id           String          @id @default(uuid())
  ventureId    String
  name         String
  code         String          @unique
  type         String          @default("MAIN")
  address      String?
  city         String?
  state        String?
  pincode      String?
  country      String          @default("India")
  latitude     Float?
  longitude    Float?
  isActive     Boolean         @default(true)
  priority     Int             @default(0)
  dailyCapacity Int            @default(500)
  currentLoad  Int             @default(0)
  geohash      String?
  managerId    String?
  contactPhone String?
  isDefault    Boolean         @default(false)
  status       WarehouseStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  venture         Venture                @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  stocks          InventoryStock[]
  stockMovements   StockMovement[]
  transfersFrom   StockTransfer[]        @relation("TransferFromWarehouse")
  transfersTo     StockTransfer[]        @relation("TransferToWarehouse")
  purchaseOrders  PurchaseOrder[]
  purchaseReceives PurchaseReceive[]
  dispatches      Dispatch[]
  posStores       PosStore[]
  allocatedOrders Order[]                @relation("OrderAllocatedWarehouse")
  zoneMappings    WarehouseZoneMapping[]
  shipments       Shipment[]
  invoices        Invoice[]
  allocationLogs  AllocationLog[]

  @@index([ventureId])
  @@index([code])
  @@index([status])
  @@index([isActive])
  @@index([geohash])
  @@map("warehouses")
}

model AllocationLog {
  id                   String   @id @default(uuid())
  orderId              String?
  customerPincode      String
  customerLatitude     Float
  customerLongitude    Float
  warehouseId          String
  calculatedDistanceKm Float
  durationMinutes      Float?   // Driving duration in minutes (OSRM only; null for legacy Haversine logs)
  routeSource          String?  // 'OSRM' | 'CACHE' | 'HAVERSINE_FALLBACK'
  allocationMethod     String   @default("ROAD_DISTANCE")
  allocationReason     String?
  createdAt            DateTime @default(now())

  // Relations
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([customerPincode])
  @@index([warehouseId])
  @@index([allocationMethod])
  @@index([createdAt])
  @@map("warehouse_allocation_logs")
}


// ─── Inventory Product & Stock ────────────────────────────────────────────────

model InventoryProduct {
  id              String                 @id @default(uuid())
  productId       String
  ventureId       String
  sku             String                 @unique
  barcode         String?                @unique
  qrCode          String?                @unique
  hsnCode         String?
  gstRate         Decimal                @default(18.0) @db.Decimal(5, 2)
  purchasePrice   Decimal                @db.Decimal(12, 2)
  sellingPrice    Decimal                @db.Decimal(12, 2)
  mrp             Decimal?               @db.Decimal(12, 2)
  currentStock    Int                    @default(0)
  reservedStock   Int                    @default(0)
  availableStock  Int                    @default(0)
  minStock        Int                    @default(5)
  maxStock        Int                    @default(500)
  reorderLevel    Int                    @default(10)
  reorderQty      Int                    @default(20)
  leadTimeDays    Int                    @default(7)
  shelfLifeDays   Int?
  rack            String?
  shelf           String?
  bin             String?
  brand           String?
  unitOfMeasure   String                 @default("PCS")
  isBatchTracked  Boolean                @default(false)
  isSerialTracked Boolean                @default(false)
  status          InventoryProductStatus @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  venture            Venture              @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  stocks             InventoryStock[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseReceiveItems PurchaseReceiveItem[]
  transferItems      StockTransferItem[]
  dispatchItems      DispatchItem[]
  posSaleItems       PosSaleItem[]

  @@index([productId])
  @@index([ventureId])
  @@index([sku])
  @@index([barcode])
  @@index([qrCode])
  @@map("inventory_products")
}

model InventoryStock {
  id                 String   @id @default(uuid())
  inventoryProductId String
  warehouseId        String
  ventureId          String
  quantity           Int      @default(0)
  reservedQty        Int      @default(0)
  damagedQty         Int      @default(0)
  lastUpdatedAt      DateTime @updatedAt
  createdAt          DateTime @default(now())

  inventoryProduct InventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Cascade)
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([inventoryProductId, warehouseId])
  @@index([inventoryProductId])
  @@index([warehouseId])
  @@index([ventureId])
  @@map("inventory_stocks")
}

// ─── Stock Movement Log ───────────────────────────────────────────────────────

model StockMovement {
  id                 String            @id @default(uuid())
  movementId         String            @unique @default(uuid())
  ventureId          String
  inventoryProductId String
  warehouseId        String
  qtyBefore          Int
  qtyChanged         Int
  qtyAfter           Int
  movementType       StockMovementType
  channel            String            @default("SYSTEM") // ONLINE, POS, MANUAL, SYSTEM
  referenceType      String?           // ORDER, POS_SALE, PURCHASE, TRANSFER, ADJUSTMENT
  referenceId        String?
  createdBy          String?
  reason             String?
  notes              String?
  createdAt          DateTime          @default(now())

  venture          Venture          @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  inventoryProduct InventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Cascade)
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([ventureId])
  @@index([inventoryProductId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─── Supplier & Procurement ───────────────────────────────────────────────────

model Supplier {
  id            String         @id @default(uuid())
  ventureId     String
  name          String
  code          String         @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  gstin         String?        @db.VarChar(15)
  pan           String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  creditDays    Int            @default(30)
  creditLimit   Decimal?       @db.Decimal(12, 2)
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  venture          Venture           @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  purchasePayments PurchasePayment[]
  ledgers          SupplierLedger[]

  @@index([ventureId])
  @@index([code])
  @@index([status])
  @@map("suppliers")
}

model SupplierLedger {
  id            String   @id @default(uuid())
  supplierId    String
  ventureId     String
  entryType     String   // DEBIT, CREDIT
  amount        Decimal  @db.Decimal(12, 2)
  balance       Decimal  @db.Decimal(12, 2)
  referenceType String?  // PURCHASE_ORDER, PAYMENT, RETURN
  referenceId   String?
  description   String?
  entryDate     DateTime @default(now())
  createdAt     DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([ventureId])
  @@map("supplier_ledgers")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  ventureId    String
  supplierId   String
  warehouseId  String
  poNumber     String              @unique
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  receivedDate DateTime?
  subtotal     Decimal             @db.Decimal(12, 2)
  taxTotal     Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal   Decimal             @db.Decimal(12, 2)
  notes        String?
  createdBy    String?
  approvedBy   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  venture          Venture           @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items            PurchaseOrderItem[]
  receives         PurchaseReceive[]
  returns          PurchaseReturn[]
  payments         PurchasePayment[]

  @@index([ventureId])
  @@index([supplierId])
  @@index([poNumber])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                 String   @id @default(uuid())
  purchaseOrderId    String
  inventoryProductId String
  orderedQty         Int
  receivedQty        Int      @default(0)
  remainingQty       Int
  unitPrice          Decimal  @db.Decimal(12, 2)
  taxRate            Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice         Decimal  @db.Decimal(12, 2)

  purchaseOrder    PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryProduct InventoryProduct     @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)
  receiveItems     PurchaseReceiveItem[]

  @@index([purchaseOrderId])
  @@index([inventoryProductId])
  @@map("purchase_order_items")
}

model PurchaseReceive {
  id              String    @id @default(uuid())
  purchaseOrderId String
  ventureId       String
  warehouseId     String
  grnNumber       String    @unique
  receivedDate    DateTime  @default(now())
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         PurchaseReceiveItem[]

  @@index([purchaseOrderId])
  @@index([grnNumber])
  @@map("purchase_receives")
}

model PurchaseReceiveItem {
  id                  String @id @default(uuid())
  purchaseReceiveId   String
  purchaseOrderItemId String
  inventoryProductId  String
  receivedQty         Int
  acceptedQty         Int
  rejectedQty         Int    @default(0)
  unitPrice           Decimal @db.Decimal(12, 2)

  purchaseReceive   PurchaseReceive   @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  inventoryProduct  InventoryProduct  @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)

  @@index([purchaseReceiveId])
  @@map("purchase_receive_items")
}

model PurchaseReturn {
  id              String   @id @default(uuid())
  purchaseOrderId String
  ventureId       String
  supplierId      String
  returnNumber    String   @unique
  reason          String?
  status          String   @default("COMPLETED")
  totalAmount     Decimal  @db.Decimal(12, 2)
  createdBy       String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("purchase_returns")
}

model PurchasePayment {
  id              String   @id @default(uuid())
  purchaseOrderId String
  supplierId      String
  ventureId       String
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @default("BANK_TRANSFER")
  referenceNumber String?
  paidAt          DateTime @default(now())
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("purchase_payments")
}

// ─── Stock Transfer ───────────────────────────────────────────────────────────

model StockTransfer {
  id              String         @id @default(uuid())
  ventureId       String
  fromWarehouseId String
  toWarehouseId   String
  fromVentureId   String?
  toVentureId     String?
  transferType    TransferType   @default(WAREHOUSE_TO_WAREHOUSE)
  transferNumber  String         @unique
  status          TransferStatus @default(DRAFT)
  requestedBy     String?
  approvedBy      String?
  dispatchedBy    String?
  receivedBy      String?
  requestedAt     DateTime       @default(now())
  approvedAt      DateTime?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  venture       Venture             @relation("VentureTransfers", fields: [ventureId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  fromVentureRef Venture?           @relation("TransferFromVenture", fields: [fromVentureId], references: [id], onDelete: SetNull)
  toVentureRef   Venture?           @relation("TransferToVenture", fields: [toVentureId], references: [id], onDelete: SetNull)
  items         StockTransferItem[]

  @@index([ventureId])
  @@index([transferNumber])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String  @id @default(uuid())
  transferId         String
  inventoryProductId String
  requestedQty       Int
  dispatchedQty      Int     @default(0)
  receivedQty        Int     @default(0)
  damagedQty         Int     @default(0)
  notes              String?

  transfer         StockTransfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryProduct InventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([inventoryProductId])
  @@map("stock_transfer_items")
}

// ─── Dispatch Management ─────────────────────────────────────────────────────

model Dispatch {
  id             String         @id @default(uuid())
  ventureId      String
  orderId        String?
  posSaleId      String?
  warehouseId    String
  dispatchNumber String         @unique
  status         DispatchStatus @default(PENDING)
  courierName    String?
  courierCode    String?
  trackingNumber String?
  vehicleNumber  String?
  vehicleType    String?
  driverName     String?
  driverPhone    String?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  notes          String?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  venture   Venture        @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     DispatchItem[]

  @@index([ventureId])
  @@index([dispatchNumber])
  @@index([status])
  @@index([orderId])
  @@map("dispatches")
}

model DispatchItem {
  id                 String @id @default(uuid())
  dispatchId         String
  inventoryProductId String
  orderedQty         Int
  dispatchedQty      Int

  dispatch         Dispatch         @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  inventoryProduct InventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)

  @@index([dispatchId])
  @@map("dispatch_items")
}

// ─── Offline POS (Point of Sale) ──────────────────────────────────────────────

model PosStore {
  id          String   @id @default(uuid())
  ventureId   String
  warehouseId String
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  managerId   String?
  gstNumber   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venture   Venture       @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  terminals PosTerminal[]
  sessions  PosSession[]
  sales     PosSale[]

  @@index([ventureId])
  @@index([code])
  @@map("pos_stores")
}

model PosTerminal {
  id           String    @id @default(uuid())
  storeId      String
  ventureId    String
  name         String
  code         String    @unique
  isActive     Boolean   @default(true)
  lastOpenedAt DateTime?
  lastClosedAt DateTime?
  createdAt    DateTime  @default(now())

  store    PosStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions PosSession[]
  sales    PosSale[]

  @@index([storeId])
  @@index([ventureId])
  @@map("pos_terminals")
}

model PosSession {
  id              String           @id @default(uuid())
  terminalId      String
  storeId         String
  ventureId       String
  cashierId       String
  status          PosSessionStatus @default(OPEN)
  openingBalance  Decimal          @db.Decimal(12, 2)
  closingBalance  Decimal?         @db.Decimal(12, 2)
  totalCashSales  Decimal          @default(0) @db.Decimal(12, 2)
  totalCardSales  Decimal          @default(0) @db.Decimal(12, 2)
  totalUpiSales   Decimal          @default(0) @db.Decimal(12, 2)
  totalSales      Decimal          @default(0) @db.Decimal(12, 2)
  expectedCash    Decimal?         @db.Decimal(12, 2)
  actualCash      Decimal?         @db.Decimal(12, 2)
  cashDifference  Decimal?         @db.Decimal(12, 2)
  openedAt        DateTime         @default(now())
  closedAt        DateTime?
  notes           String?

  terminal PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  store    PosStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales    PosSale[]
  returns  PosReturn[]

  @@index([terminalId])
  @@index([storeId])
  @@index([cashierId])
  @@index([status])
  @@map("pos_sessions")
}

model PosSale {
  id               String           @id @default(uuid())
  ventureId        String
  storeId          String
  terminalId       String
  sessionId        String
  saleNumber       String           @unique
  customerId       String?
  customerName     String?
  customerPhone    String?
  customerGstin    String?
  status           PosSaleStatus    @default(COMPLETED)
  channel          String           @default("WALK_IN") // WALK_IN, PHONE, WHATSAPP
  subtotal         Decimal          @db.Decimal(12, 2)
  discountTotal    Decimal          @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal          @db.Decimal(12, 2)
  paidAmount       Decimal          @db.Decimal(12, 2)
  changeAmount     Decimal          @default(0) @db.Decimal(12, 2)
  dueAmount        Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod    PosPaymentMethod @default(CASH)
  paymentReference String?
  notes            String?
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  store    PosStore      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  terminal PosTerminal   @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  session  PosSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items    PosSaleItem[]
  returns  PosReturn[]

  @@index([ventureId])
  @@index([storeId])
  @@index([saleNumber])
  @@index([status])
  @@map("pos_sales")
}

model PosSaleItem {
  id                 String   @id @default(uuid())
  posSaleId          String
  inventoryProductId String
  productName        String
  sku                String
  barcode            String?
  quantity           Int
  unitPrice          Decimal  @db.Decimal(12, 2)
  mrp                Decimal? @db.Decimal(12, 2)
  discountPct        Decimal  @default(0) @db.Decimal(5, 2)
  discountAmt        Decimal  @default(0) @db.Decimal(12, 2)
  taxPct             Decimal  @default(18) @db.Decimal(5, 2)
  taxAmt             Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(12, 2)

  posSale          PosSale          @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  inventoryProduct InventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)

  @@index([posSaleId])
  @@index([inventoryProductId])
  @@map("pos_sale_items")
}

model PosReturn {
  id             String   @id @default(uuid())
  originalSaleId String
  ventureId      String
  storeId        String
  sessionId      String
  returnNumber   String   @unique
  reason         String?
  refundMethod   String   @default("CASH")
  refundAmount   Decimal  @db.Decimal(12, 2)
  createdBy      String?
  createdAt      DateTime @default(now())

  originalSale PosSale    @relation(fields: [originalSaleId], references: [id], onDelete: Cascade)
  session      PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([originalSaleId])
  @@index([returnNumber])
  @@map("pos_returns")
}

// ─── Inventory Audit Log ──────────────────────────────────────────────────────

model InventoryActivityLog {
  id        String   @id @default(uuid())
  ventureId String
  userId    String?
  action    String
  module    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId])
  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("inventory_activity_logs")
}

model AsyncJob {
  id          String    @id @default(uuid())
  type        String
  queue       String    @default("default")
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status, runAt])
  @@index([lockedAt])
  @@map("async_jobs")
}

// ─── Appointment Booking System ──────────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

model AppointmentService {
  id                  String        @id @default(uuid())
  name                String
  slug                String        @unique
  description         String?
  durationMinutes     Int           @default(30)
  bufferMinutes       Int           @default(15)
  maxParallelBookings Int           @default(1)
  price               Decimal       @default(0) @db.Decimal(12, 2)
  isPaid              Boolean       @default(false)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  appointments        Appointment[]

  @@map("appointment_services")
}

model StaffAvailability {
  id          String   @id @default(uuid())
  staffUserId String
  locationId  String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffUser   User     @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, dayOfWeek])
  @@map("staff_availabilities")
}

model BlackoutDate {
  id          String   @id @default(uuid())
  locationId  String?
  staffUserId String?
  date        DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("blackout_dates")
}

model Appointment {
  id                String                   @id @default(uuid())
  appointmentNumber String                   @unique
  trackingId        String                   @unique
  serviceId         String
  locationId        String?
  customerUserId    String?
  staffUserId       String?
  customerName      String
  customerEmail     String
  customerPhone     String
  date              DateTime                 @db.Date
  startTime         String
  endTime           String
  timezone          String                   @default("Asia/Kolkata")
  status            AppointmentStatus        @default(PENDING)
  paidAmount        Decimal                  @default(0) @db.Decimal(12, 2)
  customFields      Json?
  notes             String?
  cancelReason      String?
  cancelledAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  service           AppointmentService       @relation(fields: [serviceId], references: [id])
  customerUser      User?                    @relation("CustomerAppointments", fields: [customerUserId], references: [id])
  staffUser         User?                    @relation("StaffAppointments", fields: [staffUserId], references: [id])
  statusHistory     AppointmentStatusHistory[]

  @@index([trackingId])
  @@index([appointmentNumber])
  @@index([customerEmail])
  @@index([date, status])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  comment       String?
  changedBy     String?
  createdAt     DateTime          @default(now())

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_histories")
}

// ─── Purchase Order (PO) Module ──────────────────────────────────────────────

model B2BPurchaseOrder {
  id                        String              @id @default(uuid())
  poNumber                  String              @unique @map("po_number")
  quotationId               String?             @unique @map("quotation_id")
  quotationNumber           String?             @map("quotation_number")
  poSubmissionId            String?             @unique @map("po_submission_id")
  customerId                String              @map("customer_id")
  status                    B2BPoStatus         @default(SUBMITTED)
  customerPoReferenceNumber String?             @map("customer_po_reference_number")
  billingAddress            Json                @map("billing_address")
  deliveryAddress           Json                @map("delivery_address")
  deliveryInstructions      String?             @map("delivery_instructions")
  requestedDeliveryDate     DateTime?           @map("requested_delivery_date")
  subtotal                  Decimal             @db.Decimal(12, 2)
  taxTotal                  Decimal             @db.Decimal(12, 2) @map("tax_total")
  discountTotal             Decimal             @default(0) @db.Decimal(12, 2) @map("discount_total")
  shippingCost              Decimal             @default(0) @db.Decimal(12, 2) @map("shipping_cost")
  totalAmount               Decimal             @db.Decimal(12, 2) @map("total_amount")
  currency                  String              @default("INR")
  advancePercentage         Decimal             @default(30) @db.Decimal(5, 2) @map("advance_percentage")
  advanceAmount             Decimal             @db.Decimal(12, 2) @map("advance_amount")
  balanceAmount             Decimal             @db.Decimal(12, 2) @map("balance_amount")
  validationErrors          Json?               @map("validation_errors")
  submittedAt               DateTime            @default(now()) @map("submitted_at")
  validatedAt               DateTime?           @map("validated_at")
  rejectedAt                DateTime?           @map("rejected_at")
  rejectionReason           String?             @map("rejection_reason")
  createdBy                 String?             @map("created_by")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  // Relations
  customer                  User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation                 Quote?              @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  poSubmission              PoSubmission?       @relation(fields: [poSubmissionId], references: [id], onDelete: SetNull)
  items                     B2BPurchaseOrderItem[]
  receipts                  PaymentReceipt[]
  packingList               PackingList?
  dispatch                  PoDispatch?
  invoice                   B2BPoInvoice?
  proformaInvoice           B2BProformaInvoice?
  ewayBill                  B2BEwayBill?
  issueList                 B2BIssueList?
  auditLogs                 PoAuditLog[]
  notificationLogs          PoNotificationLog[]

  @@index([poNumber])
  @@index([quotationId])
  @@index([quotationNumber])
  @@index([poSubmissionId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("b2b_purchase_orders")
}

model B2BPurchaseOrderItem {
  id              String           @id @default(uuid())
  purchaseOrderId String           @map("purchase_order_id")
  slNo            Int              @default(1) @map("sl_no")
  productId       String           @map("product_id")
  productName     String           @map("product_name")
  sku             String?
  variantId       String?          @map("variant_id")
  unit            String           @default("PCS")
  quantity        Int
  rate            Decimal          @db.Decimal(12, 2)
