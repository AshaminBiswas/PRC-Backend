// ─── PO Submissions (Dual-mode Intake: Form & Native PDF) ─────────────────────

model PoSubmission {
  id                  String             @id @default(uuid())
  submissionNumber    String             @unique @map("submission_number")
  customerId          String             @map("customer_id")
  sourceType          PoSourceType       @default(FORM) @map("source_type")
  status              PoSubmissionStatus @default(SUBMITTED)
  customerPoNumber    String             @map("customer_po_number")
  customerPoDate      DateTime?          @map("customer_po_date")
  statedTotal         Decimal?           @db.Decimal(12, 2) @map("stated_total")
  mappedTotal         Decimal?           @db.Decimal(12, 2) @map("mapped_total")
  currency            String             @default("INR")
  expectedDeliveryDate DateTime?         @map("expected_delivery_date")
  reviewedBy          String?            @map("reviewed_by")
  assignedTo          String?            @map("assigned_to")
  approvedBy          String?            @map("approved_by")
  approvedAt          DateTime?          @map("approved_at")
  rejectionReason     String?            @map("rejection_reason")
  changeRequestReason String?            @map("change_request_reason")
  billToAddress       Json?              @map("bill_to_address")
  shipToAddress       Json?              @map("ship_to_address")
  paymentTerms        String?            @map("payment_terms")
  customerNote        String?            @map("customer_note")
  submittedAt         DateTime           @default(now()) @map("submitted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  customer            User               @relation("CustomerPoSubmissions", fields: [customerId], references: [id], onDelete: Cascade)
  reviewer            User?              @relation("ReviewerPoSubmissions", fields: [reviewedBy], references: [id], onDelete: SetNull)
  assignee            User?              @relation("AssigneePoSubmissions", fields: [assignedTo], references: [id], onDelete: SetNull)
  approver            User?              @relation("ApproverPoSubmissions", fields: [approvedBy], references: [id], onDelete: SetNull)

  lineItems           PoSubmissionLineItem[]
  attachments         PoSubmissionAttachment[]
  logs                PoSubmissionLog[]
  acknowledgement     PoAcknowledgement?
  b2bPurchaseOrder    B2BPurchaseOrder?

  @@index([customerId])
  @@index([status])
  @@index([sourceType])
  @@index([customerPoNumber])
  @@index([assignedTo])
  @@index([submittedAt])
  @@map("po_submissions")
}

