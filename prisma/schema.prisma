// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum AddressType {
  BILLING
  SHIPPING
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  BANK_TRANSFER
  CREDIT_CARD
  UPI
}

enum QuoteStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum B2BPoStatus {
  DRAFT
  SUBMITTED
  VALIDATION_FAILED
  AWAITING_ADVANCE_PAYMENT
  PAYMENT_RECEIPT_SUBMITTED
  PAYMENT_ACKNOWLEDGED
  PAYMENT_VERIFIED
  PACKING_LIST_GENERATED
  PI_GENERATED
  TAX_INVOICE_GENERATED
  EWAY_BILL_GENERATED
  DISPATCHED
  ISSUE_LIST_GENERATED
  INVOICE_GENERATION_FAILED
  INVOICED
  REJECTED
  CANCELLED
}

enum PaymentReceiptStatus {
  PENDING_REVIEW
  REJECTED
  ACKNOWLEDGED
  VERIFIED
}

enum PoNotificationType {
  ADVANCE_PAYMENT_REQUEST
  PAYMENT_ACKNOWLEDGMENT
  PACKING_LIST_READY
  INVOICE_READY
}

enum PoNotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum PoSourceType {
  FORM
  PDF_UPLOAD
}

enum PoSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  ACKNOWLEDGED
  FULFILLMENT
}

enum LineItemSource {
  CUSTOMER_ENTERED
  ADMIN_MAPPED
}

enum PoSubmissionAction {
  SUBMITTED
  VIEWED
  UNDER_REVIEW
  MAPPED_LINE_ITEM
  CHANGES_REQUESTED
  CUSTOMER_RESUBMITTED
  APPROVED
  REJECTED
  ACKNOWLEDGED
  ASSIGNED
  INTERNAL_NOTE
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  companyName          String?
  gstin                String?    @db.VarChar(15)
  b2bAdvancePercentage Decimal?   @db.Decimal(5, 2) @map("b2b_advance_percentage")
  avatar               String?
  status             UserStatus @default(ACTIVE)
  isVerified         Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  // Relations
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  activityLogs       UserActivityLog[]
  addresses          Address[]
  wishlist           Wishlist?
  cart               Cart?
  orders             Order[]
  quotes             Quote[]
  couponUsages       CouponUsage[]
  payments           Payment[]
  reviews            Review[]
  enquiries          Enquiry[]
  blogPosts          BlogPost[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  ventureUsers       VentureUser[]
  staffAvailabilities StaffAvailability[]
  customerAppointments Appointment[] @relation("CustomerAppointments")
  staffAppointments    Appointment[] @relation("StaffAppointments")
  invoices             Invoice[]
  b2bCustomerPrices    B2BCustomerPrice[]
  quoteActivityLogs    QuoteActivityLog[] @relation("AdminQuoteActivity")
  b2bPurchaseOrders    B2BPurchaseOrder[]
  savedAddresses       SavedAddress[]
  poAuditLogs          PoAuditLog[]       @relation("AdminPoAuditLogs")
  verifiedReceipts     PaymentReceipt[]   @relation("AdminVerifiedReceipts")
  acknowledgedReceipts PaymentReceipt[]   @relation("AdminAcknowledgedReceipts")
  customerPoSubmissions PoSubmission[]     @relation("CustomerPoSubmissions")
  reviewedPoSubmissions PoSubmission[]     @relation("ReviewerPoSubmissions")
  assignedPoSubmissions PoSubmission[]     @relation("AssigneePoSubmissions")
  approvedPoSubmissions PoSubmission[]     @relation("ApproverPoSubmissions")
  poSubmissionLogs      PoSubmissionLog[]  @relation("PoSubmissionLogActor")

  @@index([email])
  @@index([status])
  @@index([email, deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  ventureUsers    VentureUser[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model UserActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_activity_logs")
}

model Address {
  id           String      @id @default(uuid())
  userId       String
  type         AddressType @default(SHIPPING)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String      @default("India")
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  @@index([userId])
  @@map("addresses")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  description     String?
  image           String?
  icon            String?
  parentId        String?
  level           Int            @default(0)
  position        Int            @default(0)
  status          CategoryStatus @default(ACTIVE)
  isVisible       Boolean        @default(true)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  // Self-referential relation
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  // Product relation
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([status])
  @@map("categories")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String?
  shortDesc       String?
  sku             String        @unique
  price           Decimal       @db.Decimal(12, 2)
  salePrice       Decimal?      @db.Decimal(12, 2)
  offerPrice      Decimal?      @db.Decimal(12, 2)
  thumbnail       String?
  images          String[]      @default([])
  categoryId      String?
  stock           Int           @default(0)
  reorderLevel    Int           @default(10)
  status          ProductStatus @default(DRAFT)
  isVisible       Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isBestseller    Boolean       @default(false)
  isInOffer       Boolean       @default(false)
  isNewArrival    Boolean       @default(false)
  compatibleFor   String[]      @default([])
  warranty        String?       @default("2 years")
  rating          Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount     Int           @default(0)
  weight          Decimal?      @db.Decimal(8, 3)
  dimensions      Json?
  attributes      Json?
  specification   Json?
  manufacturerInfo Json?
  colours         String[]      @default([])
  tags            String[]      @default([])
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  category          Category?        @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  wishlistItems     WishlistItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  quoteItems        QuoteItem[]
  reviews           Review[]
  inventoryProducts InventoryProduct[]
  invoiceItems      InvoiceItem[]
  b2bCustomerPrices B2BCustomerPrice[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@index([status, isVisible, isInOffer])
  @@index([status, isVisible, deletedAt])
  @@index([categoryId, status, isVisible])
  @@index([status, isVisible, isFeatured])
  @@index([status, isVisible, isBestseller])
  @@index([status, isVisible, isNewArrival])
  @@index([status, isVisible, createdAt])
  @@map("products")
}

// ─── Product Variant ──────────────────────────────────────────────────────────

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  sku         String   @unique
  name        String?
  price       Decimal  @db.Decimal(12, 2)
  salePrice   Decimal? @db.Decimal(12, 2)
  offerPrice  Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  attributes  Json
  image       String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  quoteItems    QuoteItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// ─── Wishlist & Wishlist Item ─────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  // Relations
  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ─── B2B Customer Custom Pricing ──────────────────────────────────────────────

model B2BCustomerPrice {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  price       Decimal  @db.Decimal(12, 2)
  minQuantity Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("b2b_customer_prices")
}

// ─── Cart & Cart Item ─────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  couponId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ─── Order, OrderItem & OrderStatusHistory ────────────────────────────────────

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  userId            String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod @default(RAZORPAY)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal       @db.Decimal(12, 2)
  couponId          String?
  shippingAddressId String?
  billingAddressId  String?
  shippingAddress   Json?
  billingAddress    Json?
  notes             String?
  trackingNumber    String?
  carrier           String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  allocatedWarehouseId String?
  allocatedCourierId   String?
  allocatedZoneId      String?
  allocatedAt          DateTime?
  allocationDistance   Float?
  allocationScore      Float?
  allocationReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon             Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddressRef Address?             @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressRef  Address?             @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  allocatedWarehouse Warehouse?           @relation("OrderAllocatedWarehouse", fields: [allocatedWarehouseId], references: [id], onDelete: SetNull)
  allocatedCourier   Courier?             @relation("OrderAllocatedCourier", fields: [allocatedCourierId], references: [id], onDelete: SetNull)
  allocatedZone      ShippingZone?        @relation("OrderAllocatedZone", fields: [allocatedZoneId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  couponUsages       CouponUsage[]
  shipment           Shipment?
  invoices           Invoice[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([allocatedWarehouseId])
  @@index([allocatedCourierId])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  productName String
  sku         String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  // Relations
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  comment   String?
  changedBy String?
  createdAt DateTime    @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ─── Quote & QuoteItem (B2B RFQ Module) ──────────────────────────────────────

model Quote {
  id                    String              @id @default(uuid())
  quoteNumber           String              @unique @map("quote_number")
  referenceNo           String?             @unique @map("reference_no")
  financialYear         String?             @map("financial_year")
  sequenceNo            Int?                @map("sequence_no")
  projectName           String?             @map("project_name")
  firstName             String?             @map("first_name")
  lastName              String?             @map("last_name")
  companyName           String?             @map("company_name")
  gstNo                 String?             @map("gst_no")
  email                 String?
  phone                 String?
  userId                String?             @map("user_id")
  status                QuoteStatus         @default(PENDING)
  statusReason          String?             @map("status_reason")
  basicPrice            Decimal?            @db.Decimal(12, 2) @map("basic_price")
  gstAmount             Decimal?            @db.Decimal(12, 2) @map("gst_amount")
  shippingCost          Decimal?            @db.Decimal(12, 2) @map("shipping_cost")
  subtotal              Decimal?            @db.Decimal(12, 2)
  discountTotal         Decimal?            @db.Decimal(12, 2) @map("discount_total")
  taxTotal              Decimal?            @db.Decimal(12, 2) @map("tax_total")
  grandTotal            Decimal?            @db.Decimal(12, 2) @map("grand_total")
  advancePercentage     Decimal?            @db.Decimal(5, 2) @map("advance_percentage")
  notes                 String?             @db.VarChar(500)
  adminNotes            String?             @map("admin_notes")
  termsAccepted         Boolean             @default(false) @map("terms_accepted")
  customerResponse      String              @default("pending") @map("customer_response") // 'pending' | 'accepted' | 'declined'
  customerResponseNotes String?             @map("customer_response_notes")
  customerResponseAt    DateTime?           @map("customer_response_at")
  accessToken           String?             @unique @map("access_token")
  digitalSignature      String?             @map("digital_signature")
  signedBy              String?             @map("signed_by")
  signedAt              DateTime?           @map("signed_at")
  qrCodeData            String?             @map("qr_code_data")
  validUntil            DateTime?           @map("valid_until")
  convertedOrderId      String?             @map("converted_order_id")
  isDeleted             Boolean             @default(false) @map("is_deleted")
  deletedAt             DateTime?           @map("deleted_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  // Relations
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 QuoteItem[]
  activityLogs          QuoteActivityLog[]
  b2bPurchaseOrder      B2BPurchaseOrder?

  @@index([userId])
  @@index([quoteNumber])
  @@index([referenceNo])
  @@index([status])
  @@index([email])
  @@index([gstNo])
  @@index([phone])
  @@index([accessToken])
  @@index([isDeleted])
  @@map("quotes")
}

model QuoteItem {
  id                  String          @id @default(uuid())
  quoteId             String          @map("quote_id")
  slNo                Int             @default(1) @map("sl_no")
  productId           String          @map("product_id")
  productNameSnapshot String?         @map("product_name_snapshot")
  variantId           String?         @map("variant_id")
  unit                String          @default("PCS")
  quantity            Int
  rate                Decimal?        @db.Decimal(12, 2)
  amount              Decimal?        @db.Decimal(12, 2)
  requestedPrice      Decimal?        @db.Decimal(12, 2) @map("requested_price")
  offeredPrice        Decimal?        @db.Decimal(12, 2) @map("offered_price")
  total               Decimal?        @db.Decimal(12, 2)
  createdAt           DateTime        @default(now()) @map("created_at")

  // Relations
  quote               Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteActivityLog {
  id           String     @id @default(uuid())
  quoteId      String     @map("quote_id")
  changedBy    String?    @map("changed_by")
  changeType   String     @map("change_type") // 'status_change' | 'item_edit' | 'shipping_update' | 'signed' | 'deleted' | 'customer_response'
  oldValue     Json?      @map("old_value")
  newValue     Json?      @map("new_value")
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")

  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  adminUser    User?      @relation("AdminQuoteActivity", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_activity_logs")
}

model QuoteSequence {
  id            String    @id @default(uuid())
  financialYear String    @unique @map("financial_year")
  nextNumber    Int       @default(1) @map("next_number")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("quote_sequences")
}

// ─── Coupon & CouponUsage ─────────────────────────────────────────────────────

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @db.Decimal(12, 2)
  usageLimit        Int?
  usedCount         Int          @default(0)
  perUserLimit      Int?         @default(1)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  carts  Cart[]
  orders Order[]
  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  userId            String?
  amount            Decimal       @db.Decimal(12, 2)
  refundedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("INR")
  method            PaymentMethod @default(RAZORPAY)
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  errorDetails      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payments")
}

// ─── Courier & Logistics Models ────────────────────────────────────────────────

model Courier {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  isActive    Boolean  @default(true)
  trackingUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  zones           ShippingZone[]
  rates           CourierRate[]
  shipments       Shipment[]
  allocatedOrders Order[]        @relation("OrderAllocatedCourier")

  @@index([code])
  @@index([isActive])
  @@map("couriers")
}

model ShippingZone {
  id          String   @id @default(uuid())
  courierId   String?
  zoneCode    String?
  zoneName    String?
  name        String
  description String?
  countries   String[] @default(["India"])
  states      String[] @default([])
  postalCodes String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  courier           Courier?               @relation(fields: [courierId], references: [id], onDelete: SetNull)
  rates             ShippingRate[]
  courierRates      CourierRate[]
  warehouseMappings WarehouseZoneMapping[]
  shipments         Shipment[]
  allocatedOrders   Order[]                @relation("OrderAllocatedZone")

  @@index([courierId])
  @@index([zoneCode])
  @@index([isActive])
  @@map("shipping_zones")
}

model WarehouseZoneMapping {
  id          String   @id @default(uuid())
  warehouseId String
  zoneId      String
  pinStart    String
  pinEnd      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([zoneId])
  @@index([pinStart, pinEnd])
  @@map("warehouse_zone_mappings")
}

model CourierRate {
  id                    String   @id @default(uuid())
  courierId             String
  zoneId                String
  weightFrom            Decimal  @db.Decimal(8, 3)
  weightTo              Decimal  @db.Decimal(8, 3)
  baseRate              Decimal  @db.Decimal(10, 2)
  additionalRate        Decimal  @default(0) @db.Decimal(10, 2)
  fuelSurcharge         Decimal  @default(0) @db.Decimal(5, 2)
  handlingCharge        Decimal  @default(0) @db.Decimal(10, 2)
  codCharge             Decimal  @default(0) @db.Decimal(10, 2)
  estimatedDeliveryDays Int      @default(3)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  courier Courier      @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([courierId])
  @@index([zoneId])
  @@index([weightFrom, weightTo])
  @@index([isActive])
  @@map("courier_rates")
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  warehouseId    String
  courierId      String?
  zoneId         String?
  shippingCost   Decimal  @db.Decimal(10, 2)
  deliveryDays   Int?
  trackingNumber String?
  shipmentStatus String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  courier   Courier?      @relation(fields: [courierId], references: [id], onDelete: SetNull)
  zone      ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([orderId])
  @@index([warehouseId])
  @@index([courierId])
  @@index([shipmentStatus])
  @@map("shipments")
}

// ─── Enterprise Invoice Management System Models ──────────────────────────────

enum InvoiceType {
  TAX_INVOICE
  PROFORMA_INVOICE
  QUOTATION
  DELIVERY_CHALLAN
  PACKING_SLIP
  PURCHASE_ORDER
  CREDIT_NOTE
  DEBIT_NOTE
  COMMERCIAL_INVOICE
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
  ARCHIVED
}

model Invoice {
  id                     String        @id @default(uuid())
  invoiceNumber          String        @unique
  financialYear          String
  invoiceType            InvoiceType   @default(TAX_INVOICE)
  status                 InvoiceStatus @default(DRAFT)
  customerId             String?
  warehouseId            String?
  orderId                String?
  shipmentId             String?
  paymentId              String?
  subtotal               Decimal       @db.Decimal(12, 2)
  discount               Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount          Decimal       @db.Decimal(12, 2)
  cgst                   Decimal       @default(0) @db.Decimal(12, 2)
  sgst                   Decimal       @default(0) @db.Decimal(12, 2)
  igst                   Decimal       @default(0) @db.Decimal(12, 2)
  cess                   Decimal       @default(0) @db.Decimal(12, 2)
  roundOff               Decimal       @default(0) @db.Decimal(6, 2)
  grandTotal             Decimal       @db.Decimal(12, 2)
  amountInWords          String?
  currency               String        @default("INR")
  exchangeRate           Decimal       @default(1.0) @db.Decimal(8, 4)
  placeOfSupply          String?
  isReverseCharge        Boolean       @default(false)
  dueDate                DateTime?
  paymentTerms           String?       @default("DUE_ON_RECEIPT")
  verificationToken      String        @unique @default(uuid())
  verificationId         String        @unique
  documentHash           String
  digitalSignatureStatus String        @default("UNSIGNED")
  signedAt               DateTime?
  pdfPath                String?
  createdBy              String?
  approvedBy             String?
  approvedAt             DateTime?
  emailedAt              DateTime?
  printedAt              DateTime?
  cancelledAt            DateTime?
  notes                  String?
  internalRemarks        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // Relations
  customer  User?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment  Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  history   InvoiceHistory[]

  @@index([invoiceNumber])
  @@index([financialYear])
  @@index([invoiceType])
  @@index([status])
  @@index([customerId])
  @@index([orderId])
  @@index([verificationToken])
  @@map("invoices")
}

model InvoiceItem {
  id           String   @id @default(uuid())
  invoiceId    String
  productId    String?
  sku          String
  productName  String
  description  String?
  hsnCode      String?
  unit         String   @default("PCS")
  quantity     Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  taxableValue Decimal  @db.Decimal(12, 2)
  cgstRate     Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  sgstRate     Decimal  @default(0) @db.Decimal(5, 2)
  sgstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  igstRate     Decimal  @default(0) @db.Decimal(5, 2)
  igstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  cessRate     Decimal  @default(0) @db.Decimal(5, 2)
  cessAmount   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([sku])
  @@index([hsnCode])
  @@map("invoice_items")
}

model InvoiceHistory {
  id          String   @id @default(uuid())
  invoiceId   String
  action      String
  performedBy String?
  comment     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([action])
  @@map("invoice_history")
}

model InvoiceSequence {
  id            String      @id @default(uuid())
  invoiceType   InvoiceType
  financialYear String
  branchCode    String      @default("MAIN")
  nextNumber    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([invoiceType, financialYear, branchCode])
  @@map("invoice_sequences")
}

model ShippingRate {
  id             String   @id @default(uuid())
  zoneId         String
  name           String
  minWeight      Decimal  @default(0) @db.Decimal(8, 3)
  maxWeight      Decimal? @db.Decimal(8, 3)
  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxOrderAmount Decimal? @db.Decimal(12, 2)
  rate           Decimal  @db.Decimal(10, 2)
  estimatedDays  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_rates")
}

// ─── Content & CMS Models ─────────────────────────────────────────────────────

model Review {
  id        String       @id @default(uuid())
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
