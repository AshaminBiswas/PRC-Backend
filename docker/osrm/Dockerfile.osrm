# ─── Stage 1: Download & Preprocess India OSM data ──────────────────────────
FROM ghcr.io/project-osrm/osrm-backend:v5.27.1 AS preprocessor

WORKDIR /data

ARG OSM_PBF_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf

# Download India OpenStreetMap data from Geofabrik
# Uses wget with retries and checksum validation
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*

RUN echo "Downloading India OSM data (~700MB, this may take several minutes)..." && \
    wget -q --show-progress --progress=bar:force \
         --tries=5 --retry-connrefused \
         -O india-latest.osm.pbf \
         "${OSM_PBF_URL}" && \
    echo "Download complete."

# ── OSRM Preprocessing Pipeline ─────────────────────────────────────────────
# Uses the Multi-Level Dijkstra (MLD) algorithm for fast queries.
# This runs once and produces cached .osrm files in /data/

# Step 1: Extract road network using car routing profile
RUN echo "Running osrm-extract (Step 1/3)..." && \
    osrm-extract -p /opt/car.lua india-latest.osm.pbf && \
    echo "Extract complete."

# Step 2: Partition the road network into cells (MLD algorithm)
RUN echo "Running osrm-partition (Step 2/3)..." && \
    osrm-partition india-latest.osrm && \
    echo "Partition complete."

# Step 3: Customize cell metrics (precompute routing weights)
RUN echo "Running osrm-customize (Step 3/3)..." && \
    osrm-customize india-latest.osrm && \
    echo "Customize complete."

# ─── Stage 2: Minimal Runtime Image ─────────────────────────────────────────
FROM ghcr.io/project-osrm/osrm-backend:v5.27.1

WORKDIR /data

# Copy preprocessed OSRM data files from build stage
COPY --from=preprocessor /data/ /data/

# Copy entrypoint & healthcheck scripts
COPY osrm-entrypoint.sh /osrm-entrypoint.sh
COPY healthcheck.sh /healthcheck.sh

RUN chmod +x /osrm-entrypoint.sh /healthcheck.sh

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD /healthcheck.sh

ENTRYPOINT ["/osrm-entrypoint.sh"]
